[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[layer_names]

2d_render/layer_1="world"
2d_render/layer_2="actors"
2d_render/layer_3="fx"
2d_render/layer_4="ui"
2d_physics/layer_1="player"
2d_physics/layer_2="enemy"
2d_physics/layer_3="world"
2d_physics/layer_4="pickup"
2d_physics/layer_5="hurtbox"
2d_physics/layer_6="hitbox"
2d_physics/layer_7="trigger"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/multi_bounce_occlusion/enabled=true
